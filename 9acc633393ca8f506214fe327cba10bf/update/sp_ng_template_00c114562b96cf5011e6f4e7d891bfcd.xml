        <template><![CDATA[<div class="stat-figure">
  <i
    class="fa fa-2x"
    ng-class="{'fa-bolt': metric.unit == 'Wh','fa-leaf': metric.unit == 'KgCO2e','fa-globe': metric.unit == ''}"
    aria-hidden="true"
  ></i>
</div>
<div class="stat-title">{{metric.label}}</div>
<div class="stat-value">
  {{c.valParse(metric.value)}} {{metric.unit}}
</div>
<div class="stat-desc">
  <i
    class="fa"
    ng-class="c.metricComparison[device.asset_id][metric.name].isOver ? 'fa-long-arrow-up' : 'fa-long-arrow-down'"
    aria-hidden="true"
  ></i
  ><span
    >{{c.metricComparison[device.asset_id][metric.name].percentDifference}}%
    {{c.metricComparison[device.asset_id][metric.name].isOver ? 'over' :
    'under'}} average</span
  >
</div>
]]></template>
    </sp_ng_template>
</record_update>
