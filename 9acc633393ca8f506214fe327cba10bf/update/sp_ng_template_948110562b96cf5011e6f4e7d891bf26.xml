        <template><![CDATA[<div class="stat-title">
  <h3 class="title">{{stat.label}}</h3>
  <small>${over 30 days}</small>
</div>
<div
  class="value"
  ng-class="c.metricComparison[device.asset_id][stat.name].isOver ? 'text-danger' : 'text-success'"
  style="--bg-dynamic: oklch(from currentColor l c h / 0.06);"
>
  <span class="stat-value"> {{c.valParse(stat.value)}} {{stat.unit}} </span>
  <i
    class="fa fa-2x"
    ng-class="{'fa-bolt': stat.unit == 'Wh','fa-leaf': stat.unit == 'KgCO2e','fa-globe': stat.unit == ''}"
    aria-hidden="true"
  ></i>
</div>
<small class="description">
  <i
    class="fa"
    ng-class="c.metricComparison[device.asset_id][stat.name].isOver ? 'fa-long-arrow-up' : 'fa-long-arrow-down'"
    aria-hidden="true"
  ></i
  ><span>
    {{c.metricComparison[device.asset_id][stat.name].percentDifference}}%
    {{c.metricComparison[device.asset_id][stat.name].isOver ? 'over' : 'under'}}
    average
  </span>
</small>
]]></template>
    </sp_ng_template>
</record_update>
