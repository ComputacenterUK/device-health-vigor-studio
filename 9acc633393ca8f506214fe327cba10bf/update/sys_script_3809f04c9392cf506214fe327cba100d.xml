        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	const dh = new DeviceHealth();
	const fieldNames = dh.getRatingFieldsNames();

	// Now that we have the field names, loop over them and build an array of scores
	let scoresArray = [];
	fieldNames.forEach(fieldName => {
		if (current.getValue(fieldName)) 
			scoresArray.push(current.getValue(fieldName))
	});

	// We are giving an overall score of the lowest value score,
	// even if all scores are good, with 1 poor, then overall is poor
	if (scoresArray.length == 0) {
		// No fields (or field values) found
		current.setValue('overall_score', "");
	} else if (scoresArray.indexOf('poor') > -1) {
		current.setValue('overall_score', "poor");
	} else if (scoresArray.indexOf('average') > -1) {
		current.setValue('overall_score', "average");
	} else if (scoresArray.indexOf('good') > -1) {
		current.setValue('overall_score', "good");
	}

})(current, previous);]]></script>
